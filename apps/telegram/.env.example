# Enable the Telegram channel only when explicitly configured.
V_AGENT_TELEGRAM_ENABLED=false

# Secret: create with BotFather and keep outside Git.
V_AGENT_TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to control V-Agent.
V_AGENT_TELEGRAM_ALLOWED_USER_IDS=

# Local/private V-Agent API endpoint.
V_AGENT_API_BASE_URL=http://127.0.0.1:8000
